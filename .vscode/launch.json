{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit demo app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
